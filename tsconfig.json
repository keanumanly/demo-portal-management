{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": [
        "./app/components/*"
      ],
      "@/components/headers/*": [
        "./app/components/headers/*"
      ],
      "@/notifications/common/*": [
        "./app/notifications/common/*"
      ],
      "@/profile/common/*": [
        "./app/profile/common/*"
      ],
      "@/settings/common/*": [
        "./app/settings/common/*"
      ],
      "@/settings/notifications/common/*": [
        "./app/settings/notifications/common/*"
      ],
      "@/calls/details/[id]/common/*": [
        "./app/calls/details/[id]/common/*"
      ],
      "@/calls/common/*": [
        "./app/calls/common/*"
      ],
      "@/agents/common/*": [
        "./app/agents/common/*"
      ],
      "@/transcripts/common/*": [
        "./app/transcripts/common/*"
      ],
      "@/contexts/*": [
        "./app/contexts/*"
      ],
      "@/config/*": [
        "./config/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/types/*": [
        "./types/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
